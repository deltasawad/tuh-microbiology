# Environment configuration
ENVIRONMENT=production
DEBUG=false

# Database Configuration
POSTGRES_DB=tuh_microbiology
POSTGRES_USER=postgres
POSTGRES_PASSWORD=ChangeThisToStrongPasswordSecure2026!
DATABASE_URL=postgresql://postgres:ChangeThisToStrongPasswordSecure2026!@db:5432/tuh_microbiology
# For local SQLite development without Docker:
# DATABASE_URL=sqlite:///./tuh_microbiology.db

# JWT Security
JWT_SECRET_KEY=<สร้างสตริงสุ่มเอง เช่น openssl rand -hex 32>
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480
REFRESH_TOKEN_EXPIRE_DAYS=7

# Auth Provider: local | ldap
AUTH_PROVIDER=local

# File Storage
STORAGE_PATH=./storage

# CORS Settings
CORS_ORIGINS=["*"]

# Optional Notification Integrations (Server-side Only)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
